{
  "name": "@helpwave/hightide-utils",
  "description": "helpwave's utility library",
  "author": "helpwave <support@helpwave.de> (https://helpwave.de)",
  "homepage": "https://helpwave.de",
  "repository": {
    "url": "git+https://github.com/helpwave/hightide.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "version": "0.1.5",
  "type": "module",
  "files": [
    "dist",
    "scripts/barrel.js"
  ],
  "exports": {
    "./context": {
      "types": "./dist/context/index.d.ts",
      "require": "./dist/context/index.cjs",
      "import": "./dist/context/index.js"
    },
    "./context/localization": {
      "types": "./dist/context/localization/index.d.ts",
      "require": "./dist/context/localization/index.cjs",
      "import": "./dist/context/localization/index.js"
    },
    "./context/translation": {
      "types": "./dist/context/translation/index.d.ts",
      "require": "./dist/context/translation/index.cjs",
      "import": "./dist/context/translation/index.js"
    },
    "./context/theme": {
      "types": "./dist/context/theme/index.d.ts",
      "require": "./dist/context/theme/index.cjs",
      "import": "./dist/context/theme/index.js"
    },
    "./context/debug": {
      "types": "./dist/context/debug/index.d.ts",
      "require": "./dist/context/debug/index.cjs",
      "import": "./dist/context/debug/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "require": "./dist/hooks/index.cjs",
      "import": "./dist/hooks/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "require": "./dist/i18n/index.cjs",
      "import": "./dist/i18n/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.cjs",
      "import": "./dist/utils/index.js"
    }
  },
  "bin": {
    "barrel": "scripts/barrel.js"
  },
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "build-intl": "build-intl --force -i ./locales -o ./src/i18n/translations.ts -n hightideTranslation",
    "init": "pnpm run build-intl",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@helpwave/internationalization": "0.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@helpwave/eslint-config": "0.0.11",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.2.3",
    "eslint": "9.31.0",
    "eslint-plugin-import": "2.32.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ts-jest": "29.4.6",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "keywords": [
    "utilities",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/helpwave/hightide/issues"
  }
}
