{
  "name": "@helpwave/hightide-native",
  "description": "helpwave hightide react native components",
  "author": "helpwave <support@helpwave.de> (https://helpwave.de)",
  "homepage": "https://helpwave.de",
  "repository": {
    "url": "git+https://github.com/helpwave/hightide.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "version": "0.9.4",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./components": {
      "types": "./dist/components/index.d.ts",
      "require": "./dist/components/index.cjs",
      "import": "./dist/components/index.js"
    },
    "./global-contexts": {
      "types": "./dist/global-contexts/index.d.ts",
      "require": "./dist/global-contexts/index.cjs",
      "import": "./dist/global-contexts/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "require": "./dist/hooks/index.cjs",
      "import": "./dist/hooks/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "require": "./dist/icons/index.cjs",
      "import": "./dist/icons/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "require": "./dist/theme/index.cjs",
      "import": "./dist/theme/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/types/index.cjs",
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.cjs",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "init": "node -e \"process.exit(0)\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@helpwave/hightide-design": "workspace:*",
    "@helpwave/hightide-utils": "workspace:*",
    "lucide-react-native": "0.561.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=2.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.76.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@helpwave/eslint-config": "0.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "19.0.10",
    "eslint": "9.31.0",
    "eslint-plugin-import": "2.32.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-svg": "15.12.0",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "keywords": [
    "react-native",
    "component-library",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/helpwave/hightide/issues"
  }
}
