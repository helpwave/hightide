{
  "name": "@helpwave/hightide-design",
  "description": "helpwave design tokens for hightide",
  "author": "helpwave <support@helpwave.de> (https://helpwave.de)",
  "homepage": "https://helpwave.de",
  "repository": {
    "url": "git+https://github.com/helpwave/hightide.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "version": "0.7.4",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./primitive-tokens": {
      "types": "./dist/primitive-tokens/index.d.ts",
      "require": "./dist/primitive-tokens/index.cjs",
      "import": "./dist/primitive-tokens/index.js"
    },
    "./theme-tokens": {
      "types": "./dist/theme-tokens/index.d.ts",
      "require": "./dist/theme-tokens/index.cjs",
      "import": "./dist/theme-tokens/index.js"
    },
    "./semantic-tokens": {
      "types": "./dist/semantic-tokens/index.ts",
      "require": "./dist/semantic-tokens/index.cjs",
      "import": "./dist/semantic-tokens/index.js"
    },
    "./component-tokens": {
      "types": "./dist/component-tokens/index.ts",
      "require": "./dist/component-tokens/index.ts",
      "import": "./dist/component-tokens/index.js"
    },
    "./design-system": {
      "types": "./dist/design-system/index.d.ts",
      "require": "./dist/design-system/index.cjs",
      "import": "./dist/design-system/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.cjs",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "init": "node -e \"process.exit(0)\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "node -e \"process.exit(0)\"",
    "write-token-bundle": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts-ext.mjs scripts/write-token-bundle.ts"
  },
  "devDependencies": {
    "@helpwave/eslint-config": "0.0.11",
    "@helpwave/hightide-utils": "workspace:*",
    "@types/node": "20.19.43",
    "eslint": "9.31.0",
    "eslint-plugin-import": "2.32.0",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "keywords": [
    "design-tokens",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/helpwave/hightide/issues"
  }
}